{
  "terms": [
    {
      "id": "t_vertebral_canal",
      "en": "vertebral canal",
      "ru": "позвоночный канал",
      "kind": "structure",
      "system": "other",
      "about": "Канал внутри позвоночника, образованный отверстиями позвонков. В нём лежат спинной мозг с оболочками и корешки спинномозговых нервов.",
      "relations": {},
      "diagrams": ["d_spinal_cord", "d_meninges"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": "Часть скелета; в курсе — как вместилище спинного мозга."
    },
    {
      "id": "t_spinal_cord_segment",
      "en": "spinal cord segment",
      "ru": "сегмент спинного мозга",
      "kind": "structure",
      "system": "nervous",
      "about": "Участок спинного мозга, от которого отходит одна пара спинномозговых нервов. Сегментов 31: 8 шейных, 12 грудных, 5 поясничных, 5 крестцовых и 1 копчиковый.",
      "relations": {},
      "diagrams": ["d_spinal_cord"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_conus_medullaris",
      "en": "conus medullaris",
      "ru": "мозговой конус",
      "kind": "structure",
      "system": "nervous",
      "about": "Заострённый нижний конец спинного мозга у взрослого — на уровне I–II поясничных позвонков. От него вниз тянется тонкая концевая нить.",
      "relations": {},
      "diagrams": ["d_spinal_cord"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_cervical_enlargement",
      "en": "cervical enlargement",
      "ru": "шейное утолщение",
      "kind": "structure",
      "system": "nervous",
      "about": "Утолщение спинного мозга в нижней шейной и верхней грудной части: здесь больше нейронов для мышц и кожи рук. От этих сегментов начинаются нервы плечевого сплетения.",
      "relations": {},
      "diagrams": ["d_spinal_cord"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_lumbosacral_enlargement",
      "en": "lumbosacral enlargement",
      "ru": "пояснично-крестцовое утолщение",
      "kind": "structure",
      "system": "nervous",
      "about": "Утолщение спинного мозга над мозговым конусом: в нём нейроны для мышц и кожи ног. От этих сегментов начинаются нервы поясничного и крестцового сплетений.",
      "relations": {},
      "diagrams": ["d_spinal_cord"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_cauda_equina",
      "en": "cauda equina",
      "ru": "конский хвост",
      "kind": "structure",
      "system": "nervous",
      "about": "Пучок корешков поясничных, крестцовых и копчикового нервов ниже конца спинного мозга. Корешки спускаются в позвоночном канале к своим отверстиям и напоминают конский хвост.",
      "relations": {},
      "diagrams": ["d_spinal_cord"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_grey_matter",
      "en": "grey matter",
      "ru": "серое вещество",
      "also": { "en": ["gray matter"] },
      "kind": "structure",
      "system": "nervous",
      "confusableWith": ["t_white_matter"],
      "about": "Ткань мозга, где лежат тела нейронов. В спинном мозге серое вещество внутри, в форме бабочки; в полушариях оно снаружи — это кора.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_central_canal",
      "en": "central canal",
      "ru": "центральный канал",
      "kind": "structure",
      "system": "nervous",
      "about": "Узкий канал в середине серого вещества спинного мозга со спинномозговой жидкостью. Вверху он сообщается с четвёртым желудочком мозга.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_posterior_horn",
      "en": "posterior horn",
      "ru": "задний рог",
      "also": { "en": ["dorsal horn"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Узкий задний выступ серого вещества спинного мозга. Сюда приходят чувствительные волокна задних корешков; здесь лежат вставочные нейроны.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_white_matter",
      "en": "white matter",
      "ru": "белое вещество",
      "kind": "structure",
      "system": "nervous",
      "about": "Ткань мозга из нервных волокон, одетых миелином, — он и даёт белый цвет. В спинном мозге белое вещество снаружи и проводит импульсы вверх и вниз.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_anterior_horn",
      "en": "anterior horn",
      "ru": "передний рог",
      "also": { "en": ["ventral horn"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Широкий передний выступ серого вещества спинного мозга. В нём лежат тела двигательных нейронов, аксоны которых идут к скелетным мышцам.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_anterior_root",
      "en": "anterior root",
      "ru": "передний корешок",
      "also": { "en": ["ventral root", "motor root"], "ru": ["двигательный корешок"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Корешок, который выходит из спинного мозга спереди. Состоит из аксонов двигательных нейронов — несёт команды из спинного мозга.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_posterior_root",
      "en": "posterior root",
      "ru": "задний корешок",
      "also": { "en": ["dorsal root", "sensory root"], "ru": ["чувствительный корешок"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Корешок, который входит в спинной мозг сзади. Несёт чувствительные волокна; на нём лежит спинномозговой узел.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_spinal_ganglion",
      "en": "spinal ganglion",
      "ru": "спинномозговой узел",
      "also": { "en": ["dorsal root ganglion"], "ru": ["спинномозговой ганглий"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Утолщение на заднем корешке у межпозвоночного отверстия. В нём лежат тела чувствительных нейронов; переключения на другие нейроны здесь нет.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_spinal_nerve",
      "en": "spinal nerve",
      "ru": "спинномозговой нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Смешанный нерв, который образуется у межпозвоночного отверстия из переднего и заднего корешков. Таких нервов 31 пара; вскоре после выхода каждый делится на ветви.",
      "relations": {},
      "diagrams": ["d_spinal_cord_section", "d_spinal_cord"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_meninges",
      "en": "meninges",
      "ru": "мозговые оболочки",
      "also": { "ru": ["оболочки мозга"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Три соединительнотканные оболочки, которые окружают головной и спинной мозг: снаружи твёрдая, в середине паутинная, внутри мягкая.",
      "relations": {},
      "diagrams": ["d_meninges"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_dura_mater",
      "en": "dura mater",
      "ru": "твёрдая мозговая оболочка",
      "also": { "en": ["dura"], "ru": ["твёрдая оболочка"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Наружная, самая плотная оболочка мозга. В позвоночном канале её отделяет от стенок эпидуральное пространство с жировой клетчаткой и венами.",
      "relations": {},
      "diagrams": ["d_meninges"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_arachnoid_mater",
      "en": "arachnoid mater",
      "ru": "паутинная оболочка",
      "also": { "en": ["arachnoid"], "ru": ["паутинная мозговая оболочка"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Тонкая средняя оболочка мозга, прилегает изнутри к твёрдой. От неё к мягкой оболочке тянутся тонкие тяжи, похожие на паутину; между ними — подпаутинное пространство.",
      "relations": {},
      "diagrams": ["d_meninges"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_pia_mater",
      "en": "pia mater",
      "ru": "мягкая мозговая оболочка",
      "also": { "ru": ["мягкая оболочка"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Внутренняя тонкая оболочка, плотно прилегающая к поверхности мозга и заходящая в борозды. В ней проходят сосуды, питающие мозг.",
      "relations": {},
      "diagrams": ["d_meninges"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_subarachnoid_space",
      "en": "subarachnoid space",
      "ru": "подпаутинное пространство",
      "also": { "ru": ["субарахноидальное пространство"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Пространство между паутинной и мягкой оболочками со спинномозговой жидкостью. Ниже конца спинного мозга оно расширяется — сюда вводят иглу при поясничной пункции.",
      "relations": {},
      "diagrams": ["d_meninges"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_cerebrospinal_fluid",
      "en": "cerebrospinal fluid",
      "ru": "спинномозговая жидкость",
      "also": { "ru": ["цереброспинальная жидкость", "ликвор"] },
      "kind": "concept",
      "system": "nervous",
      "about": "Прозрачная жидкость в желудочках мозга, центральном канале и подпаутинном пространстве. Омывает мозг и смягчает удары; за сутки её образуется около полулитра.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    }
  ]
}
