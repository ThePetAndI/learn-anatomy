{
  "terms": [
    {
      "id": "t_cardiovascular_system",
      "en": "cardiovascular system",
      "ru": "сердечно-сосудистая система",
      "also": { "en": ["circulatory system"], "ru": ["кровеносная система"] },
      "kind": "concept",
      "system": "circulatory",
      "about": "Сердце и кровеносные сосуды вместе. Сердце гонит кровь, сосуды разносят её по телу и возвращают обратно.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "TA2; Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_heart",
      "en": "heart",
      "ru": "сердце",
      "kind": "organ",
      "system": "circulatory",
      "about": "Полый мышечный орган в грудной полости, между лёгкими, смещён влево. Сокращаясь, гонит кровь по сосудам.",
      "relations": {},
      "diagrams": ["d_circulation", "d_coronary"],
      "audio": null,
      "source": "TA2; Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_blood_vessel",
      "en": "blood vessel",
      "ru": "кровеносный сосуд",
      "kind": "vessel",
      "system": "circulatory",
      "about": "Общее название трубок, по которым течёт кровь. Главных видов три: артерии, вены и капилляры.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_artery",
      "en": "artery",
      "ru": "артерия",
      "plural": "arteries",
      "kind": "artery",
      "system": "circulatory",
      "about": "Сосуд, по которому кровь течёт от сердца. Стенка толстая и упругая: выдерживает давление каждого толчка сердца.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_aorta",
      "en": "aorta",
      "ru": "аорта",
      "kind": "artery",
      "system": "circulatory",
      "about": "Самая крупная артерия. Выходит из левого желудочка и через свои ветви несёт кровь ко всему телу.",
      "relations": {},
      "diagrams": ["d_circulation", "d_aorta", "d_heart", "d_coronary"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_capillary",
      "en": "capillary",
      "ru": "капилляр",
      "plural": "capillaries",
      "kind": "vessel",
      "system": "circulatory",
      "about": "Самый тонкий сосуд: стенка в один слой клеток. Через неё кровь отдаёт тканям кислород и питательные вещества и забирает углекислый газ.",
      "relations": {},
      "diagrams": ["d_circulation", "d_microcirculation"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_vein",
      "en": "vein",
      "ru": "вена",
      "kind": "vein",
      "system": "circulatory",
      "confusableWith": ["t_artery"],
      "about": "Сосуд, по которому кровь течёт к сердцу. Стенка тоньше, чем у артерии; во многих венах есть клапаны — они не дают крови течь назад.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_atrium",
      "en": "atrium",
      "ru": "предсердие",
      "plural": "atria",
      "kind": "structure",
      "system": "circulatory",
      "about": "Камера сердца, в которую кровь приходит из вен. Предсердий два, правое и левое; из них кровь переходит в желудочки.",
      "relations": {},
      "diagrams": ["d_circulation"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_superior_vena_cava",
      "en": "superior vena cava",
      "ru": "верхняя полая вена",
      "plural": "venae cavae",
      "kind": "vein",
      "system": "circulatory",
      "about": "Короткая широкая вена. Собирает кровь от верхней части тела — головы, шеи, рук, стенок груди — и впадает в правое предсердие.",
      "relations": { "drainsTo": "t_right_atrium" },
      "diagrams": ["d_circulation", "d_heart", "d_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_ventricle",
      "en": "ventricle",
      "ru": "желудочек",
      "kind": "structure",
      "system": "circulatory",
      "confusableWith": ["t_atrium"],
      "about": "Камера сердца, которая выталкивает кровь в артерии. Желудочков два; стенка левого толще: он гонит кровь по всему телу. Желудочками называют и полости в головном мозге — о них в разделе о нервной системе.",
      "relations": {},
      "diagrams": ["d_circulation"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_inferior_vena_cava",
      "en": "inferior vena cava",
      "ru": "нижняя полая вена",
      "plural": "venae cavae",
      "kind": "vein",
      "system": "circulatory",
      "about": "Самая крупная вена тела. Собирает кровь от ног, таза и живота и впадает в правое предсердие.",
      "relations": { "drainsTo": "t_right_atrium" },
      "diagrams": ["d_circulation", "d_heart", "d_veins", "d_portal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_systemic_circulation",
      "en": "systemic circulation",
      "ru": "большой круг кровообращения",
      "kind": "concept",
      "system": "circulatory",
      "confusableWith": ["t_pulmonary_circulation"],
      "about": "Путь крови от левого желудочка через аорту ко всем органам и обратно — по полым венам в правое предсердие.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_lung",
      "en": "lung",
      "ru": "лёгкое",
      "kind": "organ",
      "system": "other",
      "about": "Парный орган дыхания в грудной полости. В его капиллярах кровь отдаёт углекислый газ и насыщается кислородом.",
      "relations": {},
      "diagrams": ["d_circulation"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": "Орган дыхательной системы; в курсе нужен как часть малого круга кровообращения."
    },
    {
      "id": "t_pulmonary_trunk",
      "en": "pulmonary trunk",
      "ru": "лёгочный ствол",
      "kind": "artery",
      "system": "circulatory",
      "about": "Крупная артерия: выходит из правого желудочка и делится на правую и левую лёгочные артерии. Несёт к лёгким венозную кровь.",
      "relations": {},
      "diagrams": ["d_circulation", "d_heart", "d_coronary"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_pulmonary_arteries",
      "en": "pulmonary arteries",
      "ru": "лёгочные артерии",
      "kind": "artery",
      "system": "circulatory",
      "about": "Правая и левая лёгочные артерии — ветви лёгочного ствола. Каждая несёт венозную кровь в своё лёгкое.",
      "relations": { "branchOf": "t_pulmonary_trunk" },
      "diagrams": ["d_circulation", "d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": "Лёгочные артерии приносят кровь для газообмена, а не питают ткань лёгкого — это делают бронхиальные ветви. Поэтому supplies не указано."
    },
    {
      "id": "t_venous_blood",
      "en": "venous blood",
      "ru": "венозная кровь",
      "kind": "concept",
      "system": "circulatory",
      "confusableWith": ["t_arterial_blood"],
      "about": "Кровь, бедная кислородом, тёмно-красная. В большом круге её несут вены, а к лёгким — лёгочный ствол и лёгочные артерии.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "Сапин, т. 2",
      "verified": true,
      "note": "Понятие физиологии, в TA2 его нет."
    },
    {
      "id": "t_pulmonary_veins",
      "en": "pulmonary veins",
      "ru": "лёгочные вены",
      "kind": "vein",
      "system": "circulatory",
      "confusableWith": ["t_pulmonary_arteries"],
      "about": "Несут из лёгких к сердцу кровь, насыщенную кислородом, и впадают в левое предсердие. Обычно их четыре — по две от каждого лёгкого.",
      "relations": { "drainsTo": "t_left_atrium" },
      "diagrams": ["d_circulation", "d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_pulmonary_circulation",
      "en": "pulmonary circulation",
      "ru": "малый круг кровообращения",
      "also": { "ru": ["лёгочный круг кровообращения"] },
      "kind": "concept",
      "system": "circulatory",
      "about": "Путь крови от правого желудочка через лёгочный ствол к лёгким и обратно — по лёгочным венам в левое предсердие. В лёгких кровь насыщается кислородом.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_arterial_blood",
      "en": "arterial blood",
      "ru": "артериальная кровь",
      "kind": "concept",
      "system": "circulatory",
      "about": "Кровь, насыщенная кислородом, ярко-красная. Из лёгких её несут лёгочные вены, а от сердца ко всему телу — аорта и другие артерии большого круга.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "Сапин, т. 2",
      "verified": true,
      "note": "Понятие физиологии, в TA2 его нет."
    }
  ]
}
