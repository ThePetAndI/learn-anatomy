{
  "terms": [
    {
      "id": "t_ascending_aorta",
      "en": "ascending aorta",
      "ru": "восходящая часть аорты",
      "also": { "ru": ["восходящая аорта"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Начальная часть аорты: выходит из левого желудочка и поднимается вверх и вправо. От её начала отходят правая и левая венечные артерии.",
      "relations": {},
      "diagrams": ["d_aorta"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_aortic_arch",
      "en": "aortic arch",
      "ru": "дуга аорты",
      "also": { "en": ["arch of aorta"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Изгиб аорты над сердцем, справа налево и спереди назад. От неё отходят три крупные ветви: плечеголовной ствол, левые общая сонная и подключичная артерии.",
      "relations": {},
      "diagrams": ["d_aorta"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_brachiocephalic_trunk",
      "en": "brachiocephalic trunk",
      "ru": "плечеголовной ствол",
      "kind": "artery",
      "system": "circulatory",
      "about": "Первая ветвь дуги аорты, есть только справа. Делится на правые общую сонную и подключичную артерии.",
      "relations": { "branchOf": "t_aortic_arch" },
      "diagrams": ["d_aorta"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_common_carotid_artery",
      "en": "common carotid artery",
      "ru": "общая сонная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Поднимается по шее к голове. Правая отходит от плечеголовного ствола, левая — прямо от дуги аорты. На уровне верхнего края щитовидного хряща делится на наружную и внутреннюю сонные артерии.",
      "relations": {},
      "diagrams": ["d_aorta", "d_head_neck"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": "branchOf не указан: справа и слева артерия начинается от разных сосудов."
    },
    {
      "id": "t_subclavian_artery",
      "en": "subclavian artery",
      "ru": "подключичная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Несёт кровь к руке, а частью — к шее и головному мозгу. Правая отходит от плечеголовного ствола, левая — от дуги аорты. У наружного края первого ребра продолжается в подмышечную артерию.",
      "relations": {},
      "diagrams": ["d_aorta", "d_head_neck", "d_upper_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": "branchOf не указан: справа и слева артерия начинается от разных сосудов."
    },
    {
      "id": "t_descending_aorta",
      "en": "descending aorta",
      "ru": "нисходящая часть аорты",
      "also": { "ru": ["нисходящая аорта"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Продолжение дуги аорты вниз, вдоль позвоночника. Выше диафрагмы это грудная часть, ниже — брюшная.",
      "relations": {},
      "diagrams": ["d_aorta"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_thoracic_aorta",
      "en": "thoracic aorta",
      "ru": "грудная часть аорты",
      "also": { "ru": ["грудная аорта"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Часть нисходящей аорты в грудной полости — от дуги до диафрагмы. Отдаёт ветви к стенкам груди и органам средостения.",
      "relations": {},
      "diagrams": ["d_aorta"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_abdominal_aorta",
      "en": "abdominal aorta",
      "ru": "брюшная часть аорты",
      "also": { "ru": ["брюшная аорта"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Часть нисходящей аорты ниже диафрагмы. Отдаёт ветви к органам живота и почкам, а на уровне четвёртого поясничного позвонка делится на две общие подвздошные артерии.",
      "relations": {},
      "diagrams": ["d_aorta", "d_abdomen", "d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_renal_artery",
      "en": "renal artery",
      "ru": "почечная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Парная ветвь брюшной аорты, идёт почти под прямым углом к почке. Правая длиннее левой: аорта лежит левее середины тела.",
      "relations": { "branchOf": "t_abdominal_aorta", "supplies": ["t_kidney"] },
      "diagrams": ["d_aorta"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_celiac_trunk",
      "en": "celiac trunk",
      "ru": "чревный ствол",
      "also": { "en": ["coeliac trunk"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Короткая непарная ветвь брюшной аорты сразу под диафрагмой. Делится на левую желудочную, общую печёночную и селезёночную артерии — к желудку, печени и селезёнке.",
      "relations": {
        "branchOf": "t_abdominal_aorta",
        "supplies": ["t_stomach", "t_liver", "t_spleen"],
        "suppliesPart": ["t_small_intestine"]
      },
      "diagrams": ["d_aorta", "d_abdomen"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": "suppliesPart — начало двенадцатиперстной кишки (через ветви общей печёночной артерии)."
    },
    {
      "id": "t_superior_mesenteric_artery",
