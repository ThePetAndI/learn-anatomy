{
  "terms": [
    {
      "id": "t_internal_carotid_artery",
      "en": "internal carotid artery",
      "ru": "внутренняя сонная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь общей сонной артерии. На шее ветвей не отдаёт; через сонный канал входит в полость черепа и питает головной мозг и глаз.",
      "relations": { "branchOf": "t_common_carotid_artery", "supplies": ["t_brain"] },
      "diagrams": ["d_head_neck"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_vertebral_artery",
      "en": "vertebral artery",
      "ru": "позвоночная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Первая ветвь подключичной артерии. Поднимается в отверстиях поперечных отростков шейных позвонков, входит в череп через большое затылочное отверстие и питает задние отделы мозга.",
      "relations": { "branchOf": "t_subclavian_artery", "supplies": ["t_brain"] },
      "diagrams": ["d_head_neck"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_external_carotid_artery",
      "en": "external carotid artery",
      "ru": "наружная сонная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь общей сонной артерии. Отдаёт ветви к шее, лицу и стенкам черепа; у шейки нижней челюсти делится на поверхностную височную и верхнечелюстную артерии.",
      "relations": { "branchOf": "t_common_carotid_artery" },
      "diagrams": ["d_head_neck", "d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_facial_artery",
      "en": "facial artery",
      "ru": "лицевая артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь наружной сонной артерии. Перегибается через край нижней челюсти впереди жевательной мышцы — здесь прощупывается её пульс — и идёт к углу рта и носу.",
      "relations": { "branchOf": "t_external_carotid_artery" },
      "diagrams": ["d_head_neck", "d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_superficial_temporal_artery",
      "en": "superficial temporal artery",
      "ru": "поверхностная височная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Конечная ветвь наружной сонной артерии. Поднимается впереди ушной раковины к виску; там под кожей прощупывается её пульс.",
      "relations": { "branchOf": "t_external_carotid_artery" },
      "diagrams": ["d_head_neck", "d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_axillary_artery",
      "en": "axillary artery",
      "ru": "подмышечная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Продолжение подключичной артерии в подмышечной впадине — от наружного края первого ребра до нижнего края большой круглой мышцы. Дальше она называется плечевой.",
      "relations": {},
      "diagrams": ["d_upper_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_brachial_artery",
      "en": "brachial artery",
      "ru": "плечевая артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Продолжение подмышечной артерии, идёт по внутренней стороне плеча. На ней измеряют давление; в локтевой ямке она делится на лучевую и локтевую артерии.",
      "relations": {},
      "diagrams": ["d_upper_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_radial_artery",
      "en": "radial artery",
      "ru": "лучевая артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь плечевой артерии, идёт по предплечью со стороны большого пальца. На запястье, над лучевой костью, прощупывают пульс.",
      "relations": { "branchOf": "t_brachial_artery" },
      "diagrams": ["d_upper_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_ulnar_artery",
      "en": "ulnar artery",
      "ru": "локтевая артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь плечевой артерии, идёт по предплечью со стороны мизинца к кисти.",
      "relations": { "branchOf": "t_brachial_artery" },
      "diagrams": ["d_upper_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_external_iliac_artery",
      "en": "external iliac artery",
      "ru": "наружная подвздошная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь общей подвздошной артерии. Идёт по краю малого таза к паховой связке и под ней продолжается в бедренную артерию.",
      "relations": { "branchOf": "t_common_iliac_artery" },
      "diagrams": ["d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_femoral_artery",
      "en": "femoral artery",
      "ru": "бедренная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Продолжение наружной подвздошной артерии ниже паховой связки — главная артерия ноги. В паху прощупывается её пульс; внизу она уходит назад, в подколенную ямку.",
      "relations": {},
      "diagrams": ["d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_popliteal_artery",
      "en": "popliteal artery",
      "ru": "подколенная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Продолжение бедренной артерии в подколенной ямке, позади коленного сустава. Внизу делится на переднюю и заднюю большеберцовые артерии.",
      "relations": {},
      "diagrams": ["d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_posterior_tibial_artery",
      "en": "posterior tibial artery",
      "ru": "задняя большеберцовая артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь подколенной артерии, идёт по задней поверхности голени. Позади внутренней лодыжки прощупывается её пульс; дальше она уходит на подошву.",
      "relations": { "branchOf": "t_popliteal_artery" },
      "diagrams": ["d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_internal_iliac_artery",
      "en": "internal iliac artery",
      "ru": "внутренняя подвздошная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь общей подвздошной артерии, спускается в малый таз. Питает органы и стенки таза и ягодичные мышцы.",
      "relations": { "branchOf": "t_common_iliac_artery" },
      "diagrams": ["d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_anterior_tibial_artery",
      "en": "anterior tibial artery",
      "ru": "передняя большеберцовая артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь подколенной артерии. Проходит на переднюю сторону голени и спускается к стопе, где продолжается в тыльную артерию стопы.",
      "relations": { "branchOf": "t_popliteal_artery" },
      "diagrams": ["d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_dorsalis_pedis_artery",
      "en": "dorsalis pedis artery",
      "ru": "тыльная артерия стопы",
      "also": { "en": ["dorsal artery of foot"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Продолжение передней большеберцовой артерии на тыле стопы. Её пульс прощупывается между первой и второй плюсневыми костями.",
      "relations": {},
      "diagrams": ["d_lower_limb"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_left_gastric_artery",
      "en": "left gastric artery",
      "ru": "левая желудочная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь чревного ствола. Идёт к верхней части желудка и вдоль его малой кривизны.",
      "relations": { "branchOf": "t_celiac_trunk", "supplies": ["t_stomach"] },
      "diagrams": ["d_abdomen"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_common_hepatic_artery",
      "en": "common hepatic artery",
      "ru": "общая печёночная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь чревного ствола, идёт вправо, к печени. Её ветви питают печень, а также часть желудка, двенадцатиперстную кишку и поджелудочную железу.",
      "relations": {
        "branchOf": "t_celiac_trunk",
        "supplies": ["t_liver"],
        "suppliesPart": ["t_stomach", "t_small_intestine"]
      },
      "diagrams": ["d_abdomen"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_splenic_artery",
      "en": "splenic artery",
      "ru": "селезёночная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Самая крупная ветвь чревного ствола. Извилисто идёт влево вдоль поджелудочной железы к селезёнке и отдаёт ветви к желудку.",
