    {
      "id": "t_superior_labial_artery",
      "en": "superior labial artery",
      "ru": "верхняя губная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь лицевой артерии у угла рта. Идёт в толще верхней губы и соединяется с одноимённой артерией другой стороны.",
      "relations": { "branchOf": "t_facial_artery" },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_angular_artery",
      "en": "angular artery",
      "ru": "угловая артерия",
      "kind": "artery",
      "system": "circulatory",
      "confusableWith": ["t_angular_vein"],
      "about": "Конечный отрезок лицевой артерии у внутреннего угла глаза. Соединяется с ветвями глазной артерии — так связаны бассейны наружной и внутренней сонных артерий.",
      "relations": { "branchOf": "t_facial_artery" },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_transverse_facial_artery",
      "en": "transverse facial artery",
      "ru": "поперечная артерия лица",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь поверхностной височной артерии. Идёт вперёд под скуловой дугой, над протоком околоушной железы, к щеке.",
      "relations": { "branchOf": "t_superficial_temporal_artery" },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_maxillary_artery",
      "en": "maxillary artery",
      "ru": "верхнечелюстная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Конечная ветвь наружной сонной артерии. Уходит вглубь позади ветви нижней челюсти и питает челюсти и зубы, жевательные мышцы, полость носа; от неё отходит средняя менингеальная артерия к твёрдой оболочке мозга.",
      "relations": { "branchOf": "t_external_carotid_artery" },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_infraorbital_artery",
      "en": "infraorbital artery",
      "ru": "подглазничная артерия",
      "also": { "en": ["infra-orbital artery"] },
      "kind": "artery",
      "system": "circulatory",
      "confusableWith": ["t_supraorbital_artery"],
      "about": "Ветвь верхнечелюстной артерии. Выходит на лицо через подглазничное отверстие вместе с одноимённым нервом и питает нижнее веко, щёку и верхнюю губу.",
      "relations": { "branchOf": "t_maxillary_artery" },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_inferior_labial_artery",
      "en": "inferior labial artery",
      "ru": "нижняя губная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь лицевой артерии чуть ниже угла рта. Идёт в толще нижней губы и соединяется с одноимённой артерией другой стороны.",
      "relations": { "branchOf": "t_facial_artery" },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_ophthalmic_artery",
      "en": "ophthalmic artery",
      "ru": "глазная артерия",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь внутренней сонной артерии. Входит в глазницу вместе со зрительным нервом и питает глазное яблоко, мышцы глаза, слёзную железу, а через свои ветви — кожу лба.",
      "relations": { "branchOf": "t_internal_carotid_artery", "supplies": ["t_eyeball"] },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_supraorbital_artery",
      "en": "supraorbital artery",
      "ru": "надглазничная артерия",
      "also": { "en": ["supra-orbital artery"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь глазной артерии. Выходит из глазницы на лоб через надглазничную вырезку вместе с одноимённым нервом.",
      "relations": { "branchOf": "t_ophthalmic_artery" },
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_eyeball",
      "en": "eyeball",
      "ru": "глазное яблоко",
      "kind": "organ",
      "system": "other",
      "about": "Орган зрения в глазнице. Кровь получает от глазной артерии — ветви внутренней сонной.",
      "relations": {},
      "diagrams": ["d_face_arteries"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": "Орган чувств; в курсе — как цель глазной артерии."
    },
    {
      "id": "t_facial_vein",
      "en": "facial vein",
      "ru": "лицевая вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Начинается у внутреннего угла глаза как угловая вена, идёт вниз и назад позади лицевой артерии и впадает во внутреннюю яремную вену.",
      "relations": { "drainsTo": "t_internal_jugular_vein" },
      "diagrams": ["d_face_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_retromandibular_vein",
      "en": "retromandibular vein",
      "ru": "занижнечелюстная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Образуется позади ветви нижней челюсти, в околоушной железе, слиянием поверхностной височной и верхнечелюстной вен. Её ветви уходят в лицевую и наружную яремную вены.",
      "relations": {},
      "diagrams": ["d_face_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_pterygoid_plexus",
      "en": "pterygoid plexus",
      "ru": "крыловидное сплетение",
      "kind": "vein",
      "system": "circulatory",
      "about": "Венозное сплетение в подвисочной ямке, между крыловидными мышцами. Собирает кровь от глубоких отделов лица и связано и с лицевой веной, и с пещеристым синусом.",
      "relations": {},
      "diagrams": ["d_face_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_angular_vein",
      "en": "angular vein",
      "ru": "угловая вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Начало лицевой вены у внутреннего угла глаза. Соединяется с верхней глазной веной — по этому пути инфекция с лица может попасть в полость черепа.",
      "relations": {},
      "diagrams": ["d_face_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_superior_ophthalmic_vein",
      "en": "superior ophthalmic vein",
      "ru": "верхняя глазная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Вена глазницы: собирает кровь из глазницы, а через связь с угловой веной — и с лица; впадает в пещеристый синус.",
      "relations": { "drainsTo": "t_cavernous_sinus" },
      "diagrams": ["d_face_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_cavernous_sinus",
      "en": "cavernous sinus",
      "ru": "пещеристый синус",
      "kind": "vein",
      "system": "circulatory",
      "about": "Венозная пазуха твёрдой оболочки мозга по бокам от турецкого седла, в полости черепа. В неё впадают глазные вены; через неё проходят внутренняя сонная артерия и нервы мышц глаза.",
      "relations": {},
      "diagrams": ["d_face_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    }
