{
  "terms": [
    {
      "id": "t_coronary_sulcus",
      "en": "coronary sulcus",
      "ru": "венечная борозда",
      "kind": "structure",
      "system": "circulatory",
      "about": "Борозда на поверхности сердца между предсердиями и желудочками: опоясывает его, как венец. В ней лежат венечные артерии и венечный синус.",
      "relations": {},
      "diagrams": ["d_coronary"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_right_coronary_artery",
      "en": "right coronary artery",
      "ru": "правая венечная артерия",
      "also": { "ru": ["правая коронарная артерия"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Отходит от начала восходящей аорты, идёт вправо по венечной борозде между правым предсердием и правым желудочком и уходит на заднюю поверхность сердца. Питает в основном правые отделы сердца.",
      "relations": { "branchOf": "t_ascending_aorta", "supplies": ["t_heart"] },
      "diagrams": ["d_coronary"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_coronary_sinus",
      "en": "coronary sinus",
      "ru": "венечный синус",
      "also": { "ru": ["коронарный синус"] },
      "kind": "vein",
      "system": "circulatory",
      "about": "Широкий короткий венозный сосуд в венечной борозде на задней поверхности сердца. Собирает кровь от большей части вен сердца и впадает в правое предсердие.",
      "relations": { "drainsTo": "t_right_atrium" },
      "diagrams": [],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": "Лежит на задней поверхности сердца; на схеме венечных артерий (вид спереди) его не видно."
    },
    {
      "id": "t_left_coronary_artery",
      "en": "left coronary artery",
      "ru": "левая венечная артерия",
      "also": { "ru": ["левая коронарная артерия"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Отходит от начала восходящей аорты, проходит позади лёгочного ствола и вскоре делится на переднюю межжелудочковую и огибающую ветви. Питает в основном левые отделы сердца.",
      "relations": { "branchOf": "t_ascending_aorta", "supplies": ["t_heart"] },
      "diagrams": ["d_coronary"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_anterior_interventricular_branch",
      "en": "anterior interventricular branch",
      "ru": "передняя межжелудочковая ветвь",
      "also": { "en": ["left anterior descending artery"] },
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь левой венечной артерии. Спускается по передней межжелудочковой борозде к верхушке сердца и питает переднюю стенку левого желудочка и большую часть межжелудочковой перегородки.",
      "relations": { "branchOf": "t_left_coronary_artery", "supplies": ["t_heart"] },
      "diagrams": ["d_coronary"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_circumflex_branch",
      "en": "circumflex branch",
      "ru": "огибающая ветвь",
      "kind": "artery",
      "system": "circulatory",
      "about": "Ветвь левой венечной артерии. Идёт влево по венечной борозде, огибает левый край сердца и уходит на заднюю поверхность. Питает левое предсердие и боковую стенку левого желудочка.",
      "relations": { "branchOf": "t_left_coronary_artery", "supplies": ["t_heart"] },
      "diagrams": ["d_coronary"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_epicardium",
      "en": "epicardium",
      "ru": "эпикард",
      "kind": "structure",
      "system": "circulatory",
      "confusableWith": ["t_endocardium"],
      "about": "Наружный слой стенки сердца — тонкая оболочка на его поверхности. Под ней в бороздах идут венечные сосуды.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_conducting_system_of_heart",
      "en": "conducting system of heart",
      "ru": "проводящая система сердца",
      "kind": "structure",
      "system": "circulatory",
      "about": "Особые мышечные клетки, которые сами вырабатывают импульсы и проводят их по сердцу. Благодаря ей предсердия сокращаются раньше желудочков.",
      "relations": {},
      "diagrams": ["d_conduction"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_sinoatrial_node",
      "en": "sinoatrial node",
      "ru": "синусно-предсердный узел",
      "also": { "en": ["sinuatrial node", "SA node"], "ru": ["синоатриальный узел"] },
      "kind": "structure",
      "system": "circulatory",
      "about": "В норме здесь рождается каждый импульс — узел задаёт ритм сердца. Лежит в стенке правого предсердия, у впадения верхней полой вены.",
      "relations": {},
      "diagrams": ["d_conduction"],
      "audio": null,
      "source": "TA2; Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": "В TA2 пишется sinu-atrial node; принимаются и sinoatrial, и sinuatrial."
    },
    {
      "id": "t_atrioventricular_node",
      "en": "atrioventricular node",
      "ru": "предсердно-желудочковый узел",
      "also": { "en": ["AV node"], "ru": ["атриовентрикулярный узел"] },
      "kind": "structure",
      "system": "circulatory",
      "confusableWith": ["t_atrioventricular_bundle"],
      "about": "Лежит в нижней части межпредсердной перегородки. Принимает импульс от предсердий и с короткой задержкой передаёт его желудочкам.",
      "relations": {},
      "diagrams": ["d_conduction"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_atrioventricular_bundle",
      "en": "atrioventricular bundle",
      "ru": "предсердно-желудочковый пучок",
      "also": { "en": ["bundle of His"], "ru": ["пучок Гиса"] },
      "kind": "structure",
      "system": "circulatory",
      "about": "Идёт от предсердно-желудочкового узла в межжелудочковую перегородку и делится на правую и левую ножки; по ним импульс расходится к мышце желудочков.",
      "relations": {},
      "diagrams": ["d_conduction"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_purkinje_fibers",
      "en": "Purkinje fibers",
      "ru": "волокна Пуркинье",
      "also": { "en": ["Purkinje fibres", "subendocardial branches"] },
      "kind": "structure",
      "system": "circulatory",
      "about": "Конечные разветвления проводящей системы под внутренней оболочкой желудочков. Разносят импульс по их мышце, и желудочки сокращаются почти одновременно.",
      "relations": {},
      "diagrams": ["d_conduction"],
      "audio": null,
      "source": "TA2; Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": "В TA2 — subendocardial branches (rami subendocardiales); в Gray's и учебниках — Purkinje fibres."
    },
