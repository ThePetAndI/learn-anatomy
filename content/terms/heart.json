      "en": "apex of heart",
      "ru": "верхушка сердца",
      "kind": "structure",
      "system": "circulatory",
      "about": "Закруглённый конец сердца, обращённый вперёд, вниз и влево. Его образует левый желудочек.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    }
