{
  "terms": [
    {
      "id": "t_right_atrium",
      "en": "right atrium",
      "ru": "правое предсердие",
      "kind": "structure",
      "system": "circulatory",
      "about": "Камера сердца, в которую впадают верхняя и нижняя полые вены. Отсюда венозная кровь через трёхстворчатый клапан идёт в правый желудочек.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_right_ventricle",
      "en": "right ventricle",
      "ru": "правый желудочек",
      "kind": "structure",
      "system": "circulatory",
      "about": "Выталкивает венозную кровь в лёгочный ствол — с него начинается малый круг. Стенка тоньше, чем у левого: давление в малом круге ниже.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_tricuspid_valve",
      "en": "tricuspid valve",
      "ru": "трёхстворчатый клапан",
      "also": {
        "en": ["right atrioventricular valve"],
        "ru": ["правый предсердно-желудочковый клапан"]
      },
      "kind": "structure",
      "system": "circulatory",
      "confusableWith": ["t_mitral_valve"],
      "about": "Клапан между правым предсердием и правым желудочком, у него три створки. Пропускает кровь в желудочек и не даёт ей вернуться в предсердие.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_left_atrium",
      "en": "left atrium",
      "ru": "левое предсердие",
      "kind": "structure",
      "system": "circulatory",
      "about": "Принимает из лёгочных вен кровь, насыщенную кислородом; через митральный клапан она идёт в левый желудочек. Самая задняя из камер сердца.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_left_ventricle",
      "en": "left ventricle",
      "ru": "левый желудочек",
      "kind": "structure",
      "system": "circulatory",
      "about": "Выталкивает артериальную кровь в аорту — с неё начинается большой круг. Самая толстостенная камера сердца; образует его верхушку.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_mitral_valve",
      "en": "mitral valve",
      "ru": "митральный клапан",
      "also": {
        "en": ["left atrioventricular valve", "bicuspid valve"],
        "ru": ["левый предсердно-желудочковый клапан", "двустворчатый клапан"]
      },
      "kind": "structure",
      "system": "circulatory",
      "about": "Клапан между левым предсердием и левым желудочком, у него две створки — отсюда второе название, двустворчатый. Митральным назван за сходство с митрой, головным убором епископа.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_pulmonary_valve",
      "en": "pulmonary valve",
      "ru": "клапан лёгочного ствола",
      "kind": "structure",
      "system": "circulatory",
      "about": "Клапан на выходе из правого желудочка в лёгочный ствол: три полулунные заслонки. Не даёт крови вернуться в желудочек.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_aortic_valve",
      "en": "aortic valve",
      "ru": "клапан аорты",
      "also": { "ru": ["аортальный клапан"] },
      "kind": "structure",
      "system": "circulatory",
      "about": "Клапан на выходе из левого желудочка в аорту: три полулунные заслонки. Не даёт крови вернуться в желудочек.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_interatrial_septum",
      "en": "interatrial septum",
      "ru": "межпредсердная перегородка",
      "kind": "structure",
      "system": "circulatory",
      "confusableWith": ["t_interventricular_septum"],
      "about": "Тонкая перегородка между правым и левым предсердиями.",
      "relations": {},
      "diagrams": ["d_heart"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
