{
  "terms": [
    {
      "id": "t_brachiocephalic_vein",
      "en": "brachiocephalic vein",
      "ru": "плечеголовная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Образуется слиянием внутренней яремной и подключичной вен. Плечеголовных вен две; правая и левая сливаются в верхнюю полую вену. Левая длиннее и проходит впереди ветвей дуги аорты.",
      "relations": { "drainsTo": "t_superior_vena_cava" },
      "diagrams": ["d_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_internal_jugular_vein",
      "en": "internal jugular vein",
      "ru": "внутренняя яремная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Собирает кровь от головного мозга и большей части головы и шеи. Спускается рядом с общей сонной артерией и за грудино-ключичным суставом сливается с подключичной веной.",
      "relations": { "drainsTo": "t_brachiocephalic_vein" },
      "diagrams": ["d_veins", "d_face_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_subclavian_vein",
      "en": "subclavian vein",
      "ru": "подключичная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Продолжение подмышечной вены, несёт кровь от руки. Проходит под ключицей и сливается с внутренней яремной веной в плечеголовную.",
      "relations": { "drainsTo": "t_brachiocephalic_vein" },
      "diagrams": ["d_veins", "d_arm_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_common_iliac_vein",
      "en": "common iliac vein",
      "ru": "общая подвздошная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Образуется слиянием наружной и внутренней подвздошных вен. Правая и левая общие подвздошные вены сливаются в нижнюю полую вену на уровне пятого поясничного позвонка.",
      "relations": { "drainsTo": "t_inferior_vena_cava" },
      "diagrams": ["d_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_renal_vein",
      "en": "renal vein",
      "ru": "почечная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Несёт кровь от почки в нижнюю полую вену. Левая длиннее правой и проходит впереди аорты.",
      "relations": { "drainsTo": "t_inferior_vena_cava" },
      "diagrams": ["d_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_hepatic_veins",
      "en": "hepatic veins",
      "ru": "печёночные вены",
      "kind": "vein",
      "system": "circulatory",
      "about": "Обычно три крупные вены, которые выносят кровь из печени и сразу впадают в нижнюю полую вену под диафрагмой.",
      "relations": { "drainsTo": "t_inferior_vena_cava" },
      "diagrams": ["d_veins", "d_portal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_portal_vein",
      "en": "portal vein",
      "ru": "воротная вена",
      "also": { "en": ["hepatic portal vein"], "ru": ["воротная вена печени"] },
      "kind": "vein",
      "system": "circulatory",
      "about": "Несёт в печень кровь от непарных органов живота — желудка, кишечника, селезёнки, поджелудочной железы. В печени она снова распадается на мельчайшие сосуды.",
      "relations": { "drainsTo": "t_liver" },
      "diagrams": ["d_portal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_splenic_vein",
      "en": "splenic vein",
      "ru": "селезёночная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Выносит кровь из селезёнки, идёт вправо позади поджелудочной железы и, слившись с верхней брыжеечной веной, образует воротную вену.",
      "relations": { "drainsTo": "t_portal_vein" },
      "diagrams": ["d_portal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_superior_mesenteric_vein",
      "en": "superior mesenteric vein",
      "ru": "верхняя брыжеечная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Собирает кровь от тонкой кишки и правой половины толстой. Позади поджелудочной железы сливается с селезёночной веной в воротную.",
      "relations": { "drainsTo": "t_portal_vein" },
      "diagrams": ["d_portal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_external_jugular_vein",
      "en": "external jugular vein",
      "ru": "наружная яремная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Поверхностная вена шеи: идёт под кожей поверх грудино-ключично-сосцевидной мышцы и обычно впадает в подключичную вену. Видна, когда человек напрягается.",
      "relations": { "drainsTo": "t_subclavian_vein" },
      "diagrams": ["d_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_cephalic_vein",
      "en": "cephalic vein",
      "ru": "латеральная подкожная вена руки",
      "kind": "vein",
      "system": "circulatory",
      "about": "Поверхностная вена по наружной стороне руки — со стороны большого пальца. Вверху проходит между дельтовидной и большой грудной мышцами и впадает в подмышечную вену.",
      "relations": {},
      "diagrams": ["d_arm_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_basilic_vein",
      "en": "basilic vein",
      "ru": "медиальная подкожная вена руки",
      "kind": "vein",
      "system": "circulatory",
      "about": "Поверхностная вена по внутренней стороне руки — со стороны мизинца. На середине плеча уходит вглубь и вливается в глубокие вены.",
      "relations": {},
      "diagrams": ["d_arm_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_median_cubital_vein",
      "en": "median cubital vein",
      "ru": "промежуточная вена локтя",
      "kind": "vein",
      "system": "circulatory",
      "about": "Короткая поверхностная вена в локтевой ямке: косо соединяет латеральную и медиальную подкожные вены руки. Из неё чаще всего берут кровь.",
      "relations": {},
      "diagrams": ["d_arm_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_great_saphenous_vein",
      "en": "great saphenous vein",
      "ru": "большая подкожная вена ноги",
      "kind": "vein",
      "system": "circulatory",
      "confusableWith": ["t_small_saphenous_vein"],
      "about": "Самая длинная вена тела. Начинается на тыле стопы, проходит впереди внутренней лодыжки, поднимается по внутренней стороне ноги и в паху впадает в бедренную вену.",
      "relations": { "drainsTo": "t_femoral_vein" },
      "diagrams": ["d_leg_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_femoral_vein",
      "en": "femoral vein",
      "ru": "бедренная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Глубокая вена бедра, идёт рядом с бедренной артерией. Продолжает подколенную вену, а под паховой связкой переходит в наружную подвздошную.",
      "relations": {},
      "diagrams": ["d_leg_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_venous_valve",
      "en": "venous valve",
      "ru": "венозный клапан",
      "also": { "ru": ["клапан вены"] },
      "kind": "structure",
      "system": "circulatory",
      "about": "Складки внутренней оболочки вены в виде кармашков: пропускают кровь к сердцу и не дают ей стекать назад. Особенно их много в венах ног.",
      "relations": {},
      "diagrams": ["d_leg_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_small_saphenous_vein",
      "en": "small saphenous vein",
      "ru": "малая подкожная вена ноги",
      "kind": "vein",
      "system": "circulatory",
      "about": "Начинается у наружного края стопы, проходит позади наружной лодыжки, поднимается по задней поверхности голени и в подколенной ямке впадает в подколенную вену.",
      "relations": { "drainsTo": "t_popliteal_vein" },
      "diagrams": ["d_leg_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_popliteal_vein",
      "en": "popliteal vein",
      "ru": "подколенная вена",
      "kind": "vein",
      "system": "circulatory",
      "about": "Глубокая вена в подколенной ямке, рядом с подколенной артерией. Принимает малую подкожную вену и выше продолжается в бедренную.",
      "relations": {},
      "diagrams": ["d_leg_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_perforating_veins",
      "en": "perforating veins",
      "ru": "прободающие вены",
      "also": { "ru": ["перфорантные вены"] },
      "kind": "vein",
      "system": "circulatory",
      "about": "Короткие вены, соединяющие поверхностные вены ноги с глубокими. Их клапаны пропускают кровь только вглубь.",
      "relations": {},
      "diagrams": ["d_leg_veins"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    }
  ]
}
