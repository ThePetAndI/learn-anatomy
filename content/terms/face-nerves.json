{
  "terms": [
    {
      "id": "t_trigeminal_nerve",
      "en": "trigeminal nerve",
      "ru": "тройничный нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Пятая пара черепных нервов, самый крупный нерв головы. Даёт чувствительность коже лица, слизистым носа и рта, зубам; его двигательные волокна идут к жевательным мышцам. Делится на три ветви.",
      "relations": {},
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_ophthalmic_nerve",
      "en": "ophthalmic nerve",
      "ru": "глазной нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Первая ветвь тройничного нерва, чувствительная. Идёт в глазницу и иннервирует глазное яблоко, кожу лба, верхнего века и спинки носа.",
      "relations": { "branchOf": "t_trigeminal_nerve" },
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_supraorbital_nerve",
      "en": "supraorbital nerve",
      "ru": "надглазничный нерв",
      "also": { "en": ["supra-orbital nerve"] },
      "kind": "nerve",
      "system": "nervous",
      "confusableWith": ["t_infraorbital_nerve"],
      "about": "Конечная ветвь глазного нерва (через лобный нерв). Выходит на лоб через надглазничную вырезку вместе с одноимённой артерией и даёт чувствительность коже лба и волосистой части головы.",
      "relations": {},
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": "branchOf не указан: между ним и глазным нервом — лобный нерв, которого в курсе нет."
    },
    {
      "id": "t_maxillary_nerve",
      "en": "maxillary nerve",
      "ru": "верхнечелюстной нерв",
      "kind": "nerve",
      "system": "nervous",
      "confusableWith": ["t_mandibular_nerve"],
      "about": "Вторая ветвь тройничного нерва, чувствительная. Иннервирует верхние зубы, слизистую носа и нёба, кожу щеки, нижнего века и верхней губы.",
      "relations": { "branchOf": "t_trigeminal_nerve" },
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_infraorbital_nerve",
      "en": "infraorbital nerve",
      "ru": "подглазничный нерв",
      "also": { "en": ["infra-orbital nerve"] },
      "kind": "nerve",
      "system": "nervous",
      "about": "Продолжение верхнечелюстного нерва. Выходит на лицо через подглазничное отверстие и даёт чувствительность коже нижнего века, щеки, крыла носа и верхней губы.",
      "relations": { "branchOf": "t_maxillary_nerve" },
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_infraorbital_foramen",
      "en": "infraorbital foramen",
      "ru": "подглазничное отверстие",
      "also": { "en": ["infra-orbital foramen"] },
      "kind": "structure",
      "system": "other",
      "about": "Отверстие верхней челюсти под нижним краем глазницы. Через него на лицо выходят подглазничные нерв и сосуды.",
      "relations": {},
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": "Часть кости; в курсе — как место выхода нерва."
    },
    {
      "id": "t_mandibular_nerve",
      "en": "mandibular nerve",
      "ru": "нижнечелюстной нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Третья, самая крупная ветвь тройничного нерва — смешанная. Иннервирует жевательные мышцы, нижние зубы, кожу подбородка, нижней губы и височной области.",
      "relations": { "branchOf": "t_trigeminal_nerve", "innervates": ["t_masseter"] },
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_inferior_alveolar_nerve",
      "en": "inferior alveolar nerve",
      "ru": "нижний альвеолярный нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Ветвь нижнечелюстного нерва. Входит в канал нижней челюсти и иннервирует нижние зубы; его конечная ветвь — подбородочный нерв.",
      "relations": { "branchOf": "t_mandibular_nerve" },
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_mental_nerve",
      "en": "mental nerve",
      "ru": "подбородочный нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Конечная ветвь нижнего альвеолярного нерва. Выходит через подбородочное отверстие и даёт чувствительность коже подбородка и нижней губы.",
      "relations": { "branchOf": "t_inferior_alveolar_nerve" },
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_mental_foramen",
      "en": "mental foramen",
      "ru": "подбородочное отверстие",
      "kind": "structure",
      "system": "other",
      "about": "Отверстие на наружной поверхности нижней челюсти, обычно под вторым малым коренным зубом. Через него выходят подбородочные нерв и сосуды.",
      "relations": {},
      "diagrams": ["d_trigeminal"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": "Часть кости; в курсе — как место выхода нерва."
    },
    {
      "id": "t_facial_nerve",
      "en": "facial nerve",
      "ru": "лицевой нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Седьмая пара черепных нервов. Выходит из черепа через шилососцевидное отверстие позади уха и иннервирует мимические мышцы; другие его волокна несут вкус от передних двух третей языка и идут к слёзной и части слюнных желёз.",
      "relations": { "innervates": ["t_orbicularis_oculi", "t_orbicularis_oris", "t_buccinator"] },
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_parotid_gland",
      "en": "parotid gland",
      "ru": "околоушная железа",
      "kind": "organ",
      "system": "other",
      "about": "Самая крупная слюнная железа, впереди и ниже уха. Сквозь неё проходит лицевой нерв и в ней ветвится; сама железа получает секреторные волокна от языкоглоточного нерва.",
      "relations": {},
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": "Орган пищеварительной системы; в курсе — как ориентир для лицевого нерва."
    },
    {
      "id": "t_masseter",
      "en": "masseter",
      "ru": "жевательная мышца",
      "kind": "muscle",
      "system": "other",
      "about": "Мышца на ветви нижней челюсти: поднимает челюсть, сжимая зубы. Иннервируется нижнечелюстным нервом — ветвью тройничного, а не лицевым.",
      "relations": {},
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_temporal_branches",
      "en": "temporal branches",
      "ru": "височные ветви",
      "kind": "nerve",
      "system": "nervous",
      "about": "Ветви лицевого нерва, идущие вверх через скуловую дугу к виску и лбу: к лобному брюшку затылочно-лобной мышцы и верхней части круговой мышцы глаза.",
      "relations": { "branchOf": "t_facial_nerve", "innervatesPart": ["t_orbicularis_oculi"] },
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_zygomatic_branches",
      "en": "zygomatic branches",
      "ru": "скуловые ветви",
      "kind": "nerve",
      "system": "nervous",
      "about": "Ветви лицевого нерва, идущие вперёд над скуловой костью к круговой мышце глаза: благодаря им человек зажмуривается.",
      "relations": { "branchOf": "t_facial_nerve", "innervates": ["t_orbicularis_oculi"] },
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_cervical_branch",
      "en": "cervical branch",
      "ru": "шейная ветвь",
      "kind": "nerve",
      "system": "nervous",
      "about": "Ветвь лицевого нерва, спускается на шею к подкожной мышце шеи.",
      "relations": { "branchOf": "t_facial_nerve" },
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_orbicularis_oculi",
      "en": "orbicularis oculi",
      "ru": "круговая мышца глаза",
      "kind": "muscle",
      "system": "other",
      "about": "Кольцевая мышца вокруг глазной щели: смыкает веки. Иннервируется лицевым нервом — скуловыми и височными ветвями.",
      "relations": {},
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_buccal_branches",
      "en": "buccal branches",
      "ru": "щёчные ветви",
      "kind": "nerve",
      "system": "nervous",
      "about": "Ветви лицевого нерва к щеке и верхней губе: к щёчной мышце и мышцам вокруг рта.",
      "relations": {
        "branchOf": "t_facial_nerve",
        "innervates": ["t_buccinator"],
        "innervatesPart": ["t_orbicularis_oris"]
      },
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_marginal_mandibular_branch",
      "en": "marginal mandibular branch",
      "ru": "краевая ветвь нижней челюсти",
      "kind": "nerve",
      "system": "nervous",
      "about": "Ветвь лицевого нерва, идущая вдоль края нижней челюсти к мышцам нижней губы и подбородка.",
      "relations": { "branchOf": "t_facial_nerve", "innervatesPart": ["t_orbicularis_oris"] },
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_buccinator",
      "en": "buccinator",
      "ru": "щёчная мышца",
      "kind": "muscle",
      "system": "other",
      "about": "Мышца стенки щеки: прижимает щёку к зубам и удерживает пищу между ними. Иннервируется щёчными ветвями лицевого нерва; одноимённый щёчный нерв тройничного — только чувствительный.",
      "relations": {},
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_orbicularis_oris",
      "en": "orbicularis oris",
      "ru": "круговая мышца рта",
      "kind": "muscle",
      "system": "other",
      "about": "Кольцевая мышца вокруг рта: смыкает губы и вытягивает их вперёд. Иннервируется лицевым нервом — щёчными ветвями и краевой ветвью нижней челюсти.",
      "relations": {},
      "diagrams": ["d_facial_nerve"],
      "audio": null,
      "source": "TA2; Сапин, т. 1",
      "verified": true,
      "note": ""
    }
  ]
