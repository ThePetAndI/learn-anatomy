{
  "terms": [
    {
      "id": "t_nervous_system",
      "en": "nervous system",
      "ru": "нервная система",
      "kind": "concept",
      "system": "nervous",
      "about": "Система, которая воспринимает раздражения, проводит и обрабатывает сигналы и управляет работой мышц и органов. Делится на центральную и периферическую.",
      "relations": {},
      "diagrams": ["d_nervous_system"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_central_nervous_system",
      "en": "central nervous system",
      "ru": "центральная нервная система",
      "kind": "concept",
      "system": "nervous",
      "about": "Головной и спинной мозг. Здесь обрабатываются сигналы от органов чувств и рождаются команды мышцам и органам.",
      "relations": {},
      "diagrams": ["d_nervous_system"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_spinal_cord",
      "en": "spinal cord",
      "ru": "спинной мозг",
      "kind": "organ",
      "system": "nervous",
      "about": "Часть центральной нервной системы в позвоночном канале — тяж толщиной около сантиметра. Вверху переходит в головной мозг, у взрослого кончается на уровне I–II поясничных позвонков.",
      "relations": {},
      "diagrams": ["d_nervous_system", "d_reflex_arc", "d_brain_medial", "d_spinal_cord", "d_spinal_cord_section"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_peripheral_nervous_system",
      "en": "peripheral nervous system",
      "ru": "периферическая нервная система",
      "kind": "concept",
      "system": "nervous",
      "about": "Всё, что лежит вне головного и спинного мозга: нервы и нервные узлы. Связывает центральную нервную систему с кожей, мышцами и внутренними органами.",
      "relations": {},
      "diagrams": ["d_nervous_system"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_nerve",
      "en": "nerve",
      "ru": "нерв",
      "kind": "nerve",
      "system": "nervous",
      "about": "Пучок нервных волокон — отростков нейронов — в общей соединительнотканной оболочке. Проводит импульсы между центральной нервной системой и органами; в одном нерве обычно идут и чувствительные, и двигательные волокна.",
      "relations": {},
      "diagrams": ["d_nervous_system", "d_reflex_arc"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_ganglion",
      "en": "ganglion",
      "ru": "нервный узел",
      "also": { "ru": ["ганглий"] },
      "plural": "ganglia",
      "kind": "structure",
      "system": "nervous",
      "about": "Скопление тел нейронов вне головного и спинного мозга — утолщение по ходу нерва или его корешка.",
      "relations": {},
      "diagrams": ["d_reflex_arc"],
      "audio": null,
      "source": "TA2; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_neuron",
      "en": "neuron",
      "ru": "нейрон",
      "also": { "en": ["nerve cell"], "ru": ["нервная клетка"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Нервная клетка — основная единица нервной системы. Принимает сигналы, проводит импульс и передаёт его другим клеткам.",
      "relations": {},
      "diagrams": ["d_neuron"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_dendrite",
      "en": "dendrite",
      "ru": "дендрит",
      "kind": "structure",
      "system": "nervous",
      "about": "Короткий ветвистый отросток нейрона. Принимает сигналы от других клеток и проводит их к телу нейрона; дендритов у нейрона обычно много.",
      "relations": {},
      "diagrams": ["d_neuron"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_cell_body",
      "en": "cell body",
      "ru": "тело нейрона",
      "also": { "en": ["soma"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Часть нейрона с ядром, от которой отходят отростки. Скопления тел нейронов — это серое вещество мозга и нервные узлы.",
      "relations": {},
      "diagrams": ["d_neuron"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_axon",
      "en": "axon",
      "ru": "аксон",
      "kind": "structure",
      "system": "nervous",
      "about": "Длинный отросток нейрона, обычно единственный. Проводит импульс от тела нейрона к другим клеткам; у двигательных нейронов бывает длиной около метра.",
      "relations": {},
      "diagrams": ["d_neuron"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_myelin_sheath",
      "en": "myelin sheath",
      "ru": "миелиновая оболочка",
      "kind": "structure",
      "system": "nervous",
      "about": "Муфта из богатых жиром мембран клеток-спутников (глии) вокруг многих аксонов, прерванная перехватами. По такому волокну импульс бежит в десятки раз быстрее; миелин даёт белому веществу его цвет.",
      "relations": {},
      "diagrams": ["d_neuron"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_synapse",
      "en": "synapse",
      "ru": "синапс",
      "kind": "structure",
      "system": "nervous",
      "about": "Место контакта нейрона с другой клеткой — нейроном, мышечным волокном или клеткой железы. Обычно сигнал здесь передаётся химически, через вещество-посредник (медиатор).",
      "relations": {},
      "diagrams": ["d_neuron"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_effector",
      "en": "effector",
      "ru": "эффектор",
      "also": { "ru": ["рабочий орган"] },
      "kind": "concept",
      "system": "nervous",
      "about": "Рабочий орган, который выполняет команду нервной системы: мышца сокращается, железа выделяет секрет.",
      "relations": {},
      "diagrams": ["d_reflex_arc"],
      "audio": null,
      "source": "Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_receptor",
      "en": "receptor",
      "ru": "рецептор",
      "kind": "structure",
      "system": "nervous",
      "about": "Чувствительное нервное окончание или особая клетка, которая превращает раздражение — прикосновение, тепло, свет, звук — в нервный импульс.",
      "relations": {},
      "diagrams": ["d_reflex_arc"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_sensory_neuron",
      "en": "sensory neuron",
      "ru": "чувствительный нейрон",
      "also": { "en": ["afferent neuron"], "ru": ["афферентный нейрон"] },
      "kind": "structure",
      "system": "nervous",
      "confusableWith": ["t_motor_neuron"],
      "about": "Нейрон, который несёт импульс от рецептора в центральную нервную систему. Тела таких нейронов лежат в нервных узлах рядом со спинным и головным мозгом.",
      "relations": {},
      "diagrams": ["d_reflex_arc"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_interneuron",
      "en": "interneuron",
      "ru": "вставочный нейрон",
      "also": { "ru": ["промежуточный нейрон"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Нейрон внутри центральной нервной системы, который связывает другие нейроны — например, чувствительный с двигательным. Таких нейронов больше всего.",
      "relations": {},
      "diagrams": ["d_reflex_arc"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_motor_neuron",
      "en": "motor neuron",
      "ru": "двигательный нейрон",
      "also": { "en": ["efferent neuron", "motoneuron"], "ru": ["эфферентный нейрон", "мотонейрон"] },
      "kind": "structure",
      "system": "nervous",
      "about": "Нейрон, который несёт команду из центральной нервной системы к мышце. Тела двигательных нейронов для мышц туловища и конечностей лежат в передних рогах спинного мозга.",
      "relations": {},
      "diagrams": ["d_reflex_arc"],
      "audio": null,
      "source": "Gray's Anatomy; Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_reflex_arc",
      "en": "reflex arc",
      "ru": "рефлекторная дуга",
      "kind": "concept",
      "system": "nervous",
      "about": "Путь импульса при рефлексе: от рецептора по чувствительному нейрону в спинной или головной мозг и оттуда по двигательному нейрону к рабочему органу.",
      "relations": {},
      "diagrams": ["d_reflex_arc"],
      "audio": null,
      "source": "Сапин, т. 2",
      "verified": true,
      "note": ""
    },
    {
      "id": "t_somatic_nervous_system",
      "en": "somatic nervous system",
      "ru": "соматическая нервная система",
      "kind": "concept",
      "system": "nervous",
      "about": "Часть нервной системы, которая связывает тело с внешним миром: несёт чувствительность от кожи, мышц и суставов и управляет скелетными мышцами — теми, что подчиняются воле.",
      "relations": {},
      "diagrams": [],
      "audio": null,
      "source": "Сапин, т. 2",
      "verified": true,
      "note": ""
    }
  ]
}
